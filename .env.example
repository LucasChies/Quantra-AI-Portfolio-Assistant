APP_NAME=Quantra AI Portfolio Assistant
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# LLM provider (configure only when implementing the model adapter)
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# PostgreSQL / pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quantra_assistant

# External market and macro data providers
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MACRO_DATA_PROVIDER=mock
MACRO_DATA_API_KEY=
